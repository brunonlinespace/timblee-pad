#!/bin/sh
set -eu
APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export APPDIR
BUNDLE="$APPDIR/usr/lib/timbleepad"
EXECUTABLE="$BUNDLE/timbleepad"
export PYTHONNOUSERSITE=1

case "${1:-}" in
    --appimage-theme=dark)
        export TIMBLEEPAD_APPIMAGE_THEME="dark"
        shift
        ;;
    --appimage-theme=light)
        export TIMBLEEPAD_APPIMAGE_THEME="light"
        shift
        ;;
    --appimage-theme=system)
        export TIMBLEEPAD_APPIMAGE_THEME="system"
        shift
        ;;
esac

if [ -z "${QT_PLUGIN_PATH:-}" ]; then
    for candidate in \
        "$BUNDLE/_internal/PyQt6/Qt6/plugins" \
        "$BUNDLE/PyQt6/Qt6/plugins"; do
        if [ -d "$candidate" ]; then
            export QT_PLUGIN_PATH="$candidate"
            break
        fi
    done
fi
exec "$EXECUTABLE" "$@"
